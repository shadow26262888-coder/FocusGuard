<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1A1A2E"
    android:padding="32dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_shield"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FocusGuard"
        android:textSize="32sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Akıllı Ebeveyn Kontrolü"
        android:textSize="16sp"
        android:textColor="#AAAACC"
        android:layout_marginBottom="48dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bu cihaz ne olarak kullanılacak?"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnChild"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="👦 Çocuk / Öğrenci Modu"
        android:textSize="18sp"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnParent"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="👨‍👩‍👧 Ebeveyn Modu"
        android:textSize="18sp"
        android:backgroundTint="#2196F3" />

</LinearLayout>
